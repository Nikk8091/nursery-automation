# ComfyUI headless daemon
COMFYUI_BASE_URL=http://localhost:8188

# Local LLM
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Gemini free-tier fallback (optional — project-isolated, no billing enabled)
GEMINI_API_KEY=

# Webhook alerting (spec_03 §5)
REVIEW_WEBHOOK_URL=

# YouTube Data API v3 OAuth2 (spec_06 §5)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# rclone remotes (configured once via `rclone config`, referenced here by name only)
RCLONE_GDRIVE_REMOTE=gdrive
RCLONE_R2_REMOTE=r2

# Publishing cadence (spec_06 §4 — do not raise without re-reading spec_06 §3)
MAX_UPLOADS_PER_DAY=2
MIN_INTERVAL_BETWEEN_UPLOADS_HOURS=8
